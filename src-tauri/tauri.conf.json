{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portale Commissioning",
  "version": "2.0.0",
  "identifier": "com.portalecommissioning.app",
  "build": {
    "beforeDevCommand": "node server.js",
    "beforeBuildCommand": "npm run pkg:server && npm run build:sidecar",
    "devUrl": "http://127.0.0.1:3000/index.html",
    "frontendDist": "../server-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../build/icon.ico",
        "installerHooks": "../build/installer-hooks.nsh"
      }
    }
  }
}
