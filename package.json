{
  "name": "portale-commissioning",
  "version": "3.3.1",
  "description": "Portale Commissioning",
  "scripts": {
    "dev:server": "node server.js",
    "pkg:server": "pkg server.js --targets node18-win-x64 --output server-dist/server.exe",
    "build:sidecar": "node scripts/build-sidecar.js",
    "tauri": "node scripts/tauri-wrapper.js",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run pkg:server && npm run build:sidecar && tauri build --config src-tauri/tauri.prod.conf.json",
    "rebuild:excel": "node rebuild_excel.js",
    "import:df": "node import_df.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.5.17",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": "server.js",
    "assets": [
      "package.json"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "server-dist"
  }
}
