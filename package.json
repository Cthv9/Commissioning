{
  "name": "portale-commissioning",
  "version": "1.0.0",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "electron:dev": "electron .",
    "dev": "node server.js",
    "build": "electron-builder",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1",
    "rebuild:excel": "node rebuild_excel.js",
    "import:df": "node import_df.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^32.0.1",
    "electron-builder": "^25.1.8"
  },
  "description": "Portale Commissioning (Electron)",
  "build": {
    "appId": "com.portalecommissioning.app",
    "productName": "Portale Commissioning",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "forceCodeSigning": false,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "icon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "nsis": {
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createStartMenuShortcut": false
    }
  }
}