{
  "name": "portale-commissioning",
  "version": "3.3.1",
  "description": "Portale Commissioning",
  "scripts": {
    "dev:server": "node server.js",
    "pkg:server": "pkg server.js --targets node22-win-x64 --output server-dist/server.exe",
    "build:sidecar": "node scripts/build-sidecar.js",
    "tauri": "node scripts/tauri-wrapper.js",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run pkg:server && npm run build:sidecar && tauri build --config src-tauri/tauri.prod.conf.json",
    "rebuild:excel": "node rebuild_excel.js",
    "import:df": "node import_df.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^5.2.1",
    "multer": "^1.4.5-lts.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.5",
    "@yao-pkg/pkg": "^6.22.0"
  },
  "pkg": {
    "scripts": "server.js",
    "assets": [
      "package.json"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "server-dist"
  }
}
